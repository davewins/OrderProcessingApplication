                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+f16bf7b3-d33b-467a-8a72-f897ffee4162+input&quot; xmlns:tns1=&quot;/api/T1743783650328Converted/JsonSchema&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1744275295353&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertOrderIntoDB&quot;/>&#xa;    &lt;xsl:param name=&quot;InventoryCheck&quot;/>&#xa;    &lt;xsl:template name=&quot;SendOrderDetails-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;Body>&#xa;                &lt;tns1:Order>&#xa;                    &lt;tns1:orderId>&#xa;                        &lt;xsl:value-of select=&quot;$InsertOrderIntoDB&quot;/>&#xa;                    &lt;/tns1:orderId>&#xa;                    &lt;tns1:customerId>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:customerId&quot;/>&#xa;                    &lt;/tns1:customerId>&#xa;                    &lt;tns1:orderDate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:orderDate>&#xa;                    &lt;xsl:copy-of select=&quot;$Start/tns1:products&quot;/>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$InventoryCheck/tns3:InventoryAvailable = true()&quot;>&#xa;                            &lt;tns1:status>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Processing&amp;quot;&quot;/>&#xa;                            &lt;/tns1:status>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:status>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Pending&amp;quot;&quot;/>&#xa;                            &lt;/tns1:status>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Order>&#xa;            &lt;/Body>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
